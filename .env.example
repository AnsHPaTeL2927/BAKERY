# Base URL the SPA calls for all API requests. Baked into the build at build
# time by Vite (import.meta.env.VITE_API_URL), so changing it requires a
# rebuild/redeploy — it cannot be swapped at runtime like a server env var.
#
# Local dev: leave as /api — vite.config.js proxies that to localhost:5000,
# so the browser only ever talks to one origin and CORS never comes up.
VITE_API_URL=/api

# Production (Vercel): point at the deployed backend's own origin, including
# the /api suffix. Must be an absolute URL once frontend and backend are on
# different domains — a relative path only works behind the dev proxy above.
# Must include the https:// scheme AND the /api suffix. A scheme-less value
# ("api.cakebytulsi.com") is treated by the browser as a relative path and
# resolves against the frontend origin instead:
#   https://www.cakebytulsi.com/api.cakebytulsi.com/analytics/track
# VITE_API_URL=https://api.cakebytulsi.com/api
